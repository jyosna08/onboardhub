# PostgreSQL credentials
POSTGRES_USER=onboardhub
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Shared signing secret (at least 32 characters)
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Browser origin and gateway URL
CORS_ALLOWED_ORIGINS=http://localhost:3001
VITE_API_BASE_URL=http://localhost:8090

# Bootstrap administrator (letters and numbers only; password must be 8+ characters)
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_an_admin_password_of_8_plus_chars

# Never commit docker/.env with real credentials.

# Optional low-memory JVM settings
# JAVA_OPTS=-Xmx256m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError
