# Copy to docker/.env on the server; keep it private and git-ignored.
# Passwords must use letters and digits only.
DOCKER_USERNAME=replace_with_docker_hub_username
IMAGE_TAG=latest
API_DOMAIN=replace_with_name.duckdns.org
CORS_ALLOWED_ORIGINS=replace_with_https_vercel_url
POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_postgres_password
JWT_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000
BOOTSTRAP_ADMIN_NAME=replace_with_admin_name
BOOTSTRAP_ADMIN_EMAIL=replace_with_admin_email
BOOTSTRAP_ADMIN_PASSWORD=replace_with_admin_password
JAVA_OPTS=-Xmx384m -XX:+ExitOnOutOfMemoryError
